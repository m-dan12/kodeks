{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-cards.local/schema/character.schema.json",
  "title": "Бланк персонажа игрока",
  "description": "Полноценный персонаж игрока. Экспортируется в Long Story Short. Правило: вы выбираете и придумываете, приложение считает. НЕ указывайте модификаторы, бонус мастерства, КД, максимум хитов, бонусы навыков и спасбросков, бонусы атак, Сл заклинаний, ячейки заклинаний: всё это посчитает приложение. Придумайте для игрока: предысторию, характер, идеалы, привязанности, изъяны, внешность, отношения. В MVP поддерживается один класс (мультиклассы только для NPC).",
  "type": "object",
  "required": [
    "schema_version", "ruleset", "kind", "name", "race", "background", "classes", "abilities", "personality"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "ruleset": { "$ref": "common.schema.json#/$defs/ruleset" },
    "kind": { "const": "character" },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "player_name": { "$ref": "common.schema.json#/$defs/text" },
    "race": { "$ref": "npc.schema.json#/properties/race" },
    "background": { "$ref": "common.schema.json#/$defs/text", "description": "Название предыстории." },
    "alignment": { "$ref": "common.schema.json#/$defs/text" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "description": "Класс и уровень. Пока поддерживается один класс.",
      "items": { "$ref": "npc.schema.json#/properties/classes/items" }
    },
    "experience": { "type": "integer", "minimum": 0, "description": "Очки опыта. Если опущено, берётся минимум для уровня." },
    "abilities": { "$ref": "common.schema.json#/$defs/ability_scores" },
    "speed": { "$ref": "common.schema.json#/$defs/speed" },
    "hit_points": { "$ref": "npc.schema.json#/properties/hit_points" },
    "defense": { "$ref": "npc.schema.json#/properties/defense" },
    "skill_proficiencies": { "$ref": "npc.schema.json#/properties/skill_proficiencies" },
    "save_proficiencies": { "$ref": "npc.schema.json#/properties/save_proficiencies" },
    "proficiencies": { "$ref": "npc.schema.json#/properties/proficiencies" },
    "languages": { "$ref": "npc.schema.json#/properties/languages" },
    "weapons": { "$ref": "npc.schema.json#/properties/weapons" },
    "features": { "$ref": "npc.schema.json#/properties/features" },
    "spellcasting": { "$ref": "npc.schema.json#/properties/spellcasting" },
    "equipment": { "$ref": "npc.schema.json#/properties/equipment" },
    "body": {
      "type": "object",
      "description": "Внешние данные. Значения строками, как их напишет игрок.",
      "additionalProperties": false,
      "properties": {
        "age": { "$ref": "common.schema.json#/$defs/text" },
        "height": { "$ref": "common.schema.json#/$defs/text" },
        "weight": { "$ref": "common.schema.json#/$defs/text" },
        "eyes": { "$ref": "common.schema.json#/$defs/text" },
        "skin": { "$ref": "common.schema.json#/$defs/text" },
        "hair": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "personality": {
      "type": "object",
      "description": "Главное в персонаже для игрока. Пишите живо, но коротко: по одному-два предложения на поле, предыстория подробнее.",
      "required": ["traits", "ideals", "bonds", "flaws", "backstory"],
      "additionalProperties": false,
      "properties": {
        "appearance": { "$ref": "common.schema.json#/$defs/text" },
        "traits": { "$ref": "common.schema.json#/$defs/text", "description": "Черты характера." },
        "ideals": { "$ref": "common.schema.json#/$defs/text" },
        "bonds": { "$ref": "common.schema.json#/$defs/text", "description": "Привязанности." },
        "flaws": { "$ref": "common.schema.json#/$defs/text", "description": "Изъяны." },
        "backstory": { "$ref": "common.schema.json#/$defs/text" },
        "goals": { "$ref": "common.schema.json#/$defs/text", "description": "Цели и задачи." },
        "relationships": {
          "type": "array",
          "description": "Союзники, организации, значимые люди.",
          "items": {
            "type": "object",
            "required": ["name", "relation"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/text" },
              "relation": { "$ref": "common.schema.json#/$defs/text" }
            }
          }
        }
      }
    },
    "inspiration": { "type": "boolean" },
    "dm_notes": { "$ref": "common.schema.json#/$defs/dm_notes" },
    "source": { "$ref": "common.schema.json#/$defs/source" }
  }
}
